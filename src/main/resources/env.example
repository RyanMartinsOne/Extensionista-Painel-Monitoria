# --- Banco de dados ---
DB_USER=monitoria_user
DB_PASSWORD=troque-esta-senha

# --- JWT ---
JWT_SECRET=gere-um-segredo-longo-e-aleatorio-aqui

# --- CORS ---
# URL do seu frontend na Vercel (sem barra no final), ex:
# CORS_ALLOWED_ORIGIN=https://meu-painel.vercel.app
CORS_ALLOWED_ORIGIN=https://SEU-APP.vercel.app

# --- DuckDNS ---
DUCKDNS_SUBDOMAIN=SEU-SUBDOMINIO
DUCKDNS_TOKEN=SEU-TOKEN-DO-DUCKDNS

# --- Caddy / HTTPS ---
# Domínio completo que vai apontar pro IP da instância
DOMAIN=SEU-SUBDOMINIO.duckdns.org
# Email usado pelo Let's Encrypt para avisos de expiração de certificado
ACME_EMAIL=seu-email@exemplo.com
